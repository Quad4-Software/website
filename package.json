{
  "name": "quad4-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "panda codegen && vite",
    "build": "panda codegen && vite build",
    "preview": "vite preview",
    "test": "panda codegen && vitest run",
    "typecheck": "panda codegen && node node_modules/typescript/bin/tsc --noEmit -p tsconfig.json",
    "typecheck:native": "panda codegen && node node_modules/@typescript/native/bin/tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lhci": "lhci autorun"
  },
  "dependencies": {
    "@ark-ui/solid": "5.39.2",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@fontsource/space-mono": "5.3.0",
    "@solidjs/meta": "0.29.4",
    "@solidjs/router": "1.0.0",
    "lucide-solid": "1.47.0",
    "simple-icons": "16.32.0",
    "solid-js": "1.9.15"
  },
  "devDependencies": {
    "@lhci/cli": "0.15.1",
    "@pandacss/dev": "1.12.1",
    "@solidjs/testing-library": "0.8.10",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.11.0",
    "eslint-plugin-solid": "0.18.0",
    "fast-check": "4.10.2",
    "globals": "17.12.0",
    "happy-dom": "20.14.5",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.0",
    "vite-plugin-solid": "2.11.14",
    "vitest": "5.0.1"
  }
}
