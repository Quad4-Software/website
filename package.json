{
  "name": "quad4-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "typecheck": "astro check",
    "typecheck:native": "node node_modules/@typescript/native/bin/tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lhci": "lhci autorun",
    "build:edge": "pnpm build && cargo build --release --locked --target wasm32-wasip2 --manifest-path edge/Cargo.toml",
    "test:edge": "cargo test --manifest-path edge/Cargo.toml",
    "serve:edge": "wasmtime serve -S cli --addr 127.0.0.1:8080 edge/target/wasm32-wasip2/release/quad4_edge.wasm"
  },
  "dependencies": {
    "@lucide/astro": "1.49.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.5",
    "simple-icons": "16.33.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@lhci/cli": "0.15.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.11.0",
    "eslint-plugin-astro": "3.2.1",
    "fast-check": "4.10.2",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "typescript": "7.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
