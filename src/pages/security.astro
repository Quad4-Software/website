---
import {
  Bug,
  ExternalLink,
  Gauge,
  PackageSearch,
  ScanLine,
  Sparkles,
  Telescope,
} from '@lucide/astro'
import PageHeader from '../components/PageHeader.astro'
import Base from '../layouts/Base.astro'
import { SITE } from '../config/site'
import { badge, button, card, cx } from '../lib/styles'

const cardHead = 'mb-3 flex flex-wrap items-center gap-3'
const cardName = 'font-mono text-lg font-bold tracking-[0.02em]'
const cardDesc = 'mb-4 text-sm leading-relaxed text-muted'

const ravenguardFeatures = [
  'rate limits',
  'bot detection',
  'pow challenge',
  'owasp crs',
  'threat intel',
  'access gates',
]

const capabilities = [
  {
    icon: ScanLine,
    title: 'Static scanning',
    text: 'SAST, secrets and misconfig checks across the whole tree.',
  },
  {
    icon: PackageSearch,
    title: 'Supply chain',
    text: 'Dependencies, lockfiles, CI permissions and release artifacts.',
  },
  {
    icon: Bug,
    title: 'Private tooling',
    text: 'Our own methodology for hunting bugs and security flaws.',
  },
  {
    icon: Sparkles,
    title: 'AI Security Auditing',
    text: 'Using zero-data retention open-weight models.',
  },
]
---

<Base
  title="Security"
  description="Quad4 audits software for free. Code audits and supply chain analysis for any git repository, including rngit remotes, reported privately to the maintainer."
  path="/security"
>
  <PageHeader
    title="Security"
    blurb="We audit software for free. Send us a repository and we read the code, check what it pulls in, and tell you what we find before anyone else hears about it."
  />

  <div class="relative mx-auto grid max-w-6xl gap-5 overflow-x-clip px-5 pb-10 md:px-8 md:pb-14">
    <Telescope
      size={260}
      aria-hidden="true"
      class="pointer-events-none absolute -top-12 right-0 -z-10 rotate-[-12deg] text-faint opacity-[0.12] md:-right-4"
    />

    <div class="relative overflow-hidden rounded-xl border border-line bg-surface-alpha p-5 md:p-7">
      <span
        class="pointer-events-none absolute inset-0 opacity-35"
        style="background: radial-gradient(24rem 12rem at 88% -15%, var(--glow), transparent 70%)"
      ></span>
      <div>
        <div class={cardHead}>
          <Gauge size={18} aria-hidden="true" />
          <span class={cardName}>Quad4 Security Platform</span>
          <span class={badge('solid')}>Coming soon</span>
        </div>
        <p class={cardDesc}>
          Our own audit dashboard. Point it at any git repo, including rngit remotes, and it scans
          the code for security issues.
        </p>
        <div class="mt-5 grid grid-cols-1 gap-3 sm:grid-cols-2">
          {capabilities.map((c) => (
            <div class="flex items-start gap-3">
              <span class="inline-flex size-8 shrink-0 items-center justify-center rounded-md border border-line text-fg">
                <c.icon size={15} aria-hidden="true" />
              </span>
              <div>
                <div class="text-sm font-semibold">{c.title}</div>
                <div class="mt-0.5 text-xs leading-relaxed text-muted">{c.text}</div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <div class={cx(card, 'relative')}>
      <span class={cx(badge('warn'), 'absolute top-3 right-3')}>Alpha</span>
      <div class={cardHead}>
        <img
          src="/ravenguard.webp"
          alt=""
          width={28}
          height={28}
          class="size-7 shrink-0 object-contain"
        />
        <span class={cardName}>Ravenguard</span>
      </div>
      <p class={cardDesc}>
        Our web application firewall. Blocks bots, scanners and AI scrapers before they reach your
        site.
      </p>
      <div class="mb-4 flex flex-wrap gap-2">
        {ravenguardFeatures.map((f) => (
          <span class="rounded-full border border-line px-2.5 py-1 font-mono text-xs text-muted">
            {f}
          </span>
        ))}
      </div>
      <a href={SITE.links.ravenguard} target="_blank" rel="noopener noreferrer" class={button()}>
        ravenguard.quad4.io <ExternalLink size={13} aria-hidden="true" />
      </a>
    </div>
  </div>
</Base>
