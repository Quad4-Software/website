---
import { ringsFor } from '../lib/orbit'

interface Props {
  seed: string
  size?: number
  class?: string
}

const { seed, size = 26, class: className = 'block shrink-0 text-fg' } = Astro.props
const rings = ringsFor(seed)
---

<svg viewBox="0 0 40 40" width={size} height={size} class={className} aria-hidden="true">
  <circle cx="20" cy="20" r="2" fill="currentColor"></circle>
  {rings.map((ring) => (
    <>
      <circle
        cx="20"
        cy="20"
        r={ring.r}
        fill="none"
        stroke="currentColor"
        stroke-width="1"
        opacity="0.3"
      />
      <circle
        cx={20 + Math.cos(ring.dotA) * ring.r}
        cy={20 + Math.sin(ring.dotA) * ring.r}
        r="1.6"
        fill="currentColor"
      />
    </>
  ))}
</svg>
